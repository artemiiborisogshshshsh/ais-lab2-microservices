{
  "uid": "ais-technical",
  "title": "AIS - Technical Monitoring",
  "tags": ["AIS", "Lab8", "Technical"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Available Targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0, "y": 0, "w": 12, "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 14}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Unavailable Targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12, "y": 0, "w": 12, "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up) - sum(up)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0, "y": 4, "w": 12, "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12, "y": 4, "w": 12, "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "HTTP Errors (last 5 minutes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0, "y": 12, "w": 12, "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (increase(errors_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "RabbitMQ Operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12, "y": 12, "w": 12, "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, outcome) (message_processing_total)",
          "legendFormat": "{{job}} - {{outcome}}"
        }
      ]
    }
  ]
}